# Supply these securely as process environment variables; this file is not loaded automatically.
# Never commit a populated file. TOTP secret means the Base32 enrollment seed, not a six-digit code.
PORTAL_USERNAME=
PORTAL_PASSWORD=
# Default GitHub adapter uses native authenticator-app TOTP.
PORTAL_TOTP_SECRET=
# Optional email adapter: portals/github-email.json. Use an app password or OAuth.
# IMAP_HOST=imap.gmail.com
# IMAP_USERNAME=
# IMAP_PASSWORD=
# IMAP_ACCESS_TOKEN=
# IMAP_SENDER=noreply@github.com
# IMAP_SUBJECT=GitHub
# IMAP_FOLDER=INBOX
# IMAP_CODE_PATTERN=(?<!\d)(\d{6,8})(?!\d)
# IMAP_TIMEOUT_SECONDS=90
# Optional: an installed Chromium executable; otherwise system Chromium or Playwright Chromium is used.
# BROWSER_EXECUTABLE=/usr/bin/chromium
